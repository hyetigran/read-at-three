{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "apps/web/vite.config.ts",
    "drizzle.config.ts"
  ]
}
